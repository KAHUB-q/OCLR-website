[Unit]
Description=Refresh OCLR public o!TR ratings
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=oclr
Group=oclr
WorkingDirectory=/opt/oclr/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/oclr/runtime.env
ExecStart=/usr/bin/node --import tsx /opt/oclr/current/scripts/refresh-otr-ratings.ts --apply
TimeoutStartSec=2h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
